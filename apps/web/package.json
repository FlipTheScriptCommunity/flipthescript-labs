{
  "name": "@flipthescript-academy/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "cf:build": "opennextjs-cloudflare build --skipNextBuild",
    "preview": "opennextjs-cloudflare preview --skipNextBuild",
    "deploy": "opennextjs-cloudflare deploy --skipNextBuild",
    "cf:deploy": "wrangler deploy",
    "cf:upload": "wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "~16.1.6",
    "postcss": "^8.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  },
  "nx": {
    "targets": {
      "cf:build": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.open-next"
        ]
      },
      "preview": {
        "dependsOn": [
          "build"
        ],
        "continuous": true
      },
      "deploy": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
