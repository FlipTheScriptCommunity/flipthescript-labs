{
  "name": "@flipthescript-academy/infra-cdk",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "synth": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "infra/cdk",
          "command": "cdk synth"
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "infra/cdk",
          "command": "cdk deploy --all"
        }
      },
      "diff": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "infra/cdk",
          "command": "cdk diff"
        }
      }
    }
  },
  "dependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.7.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.1132.0"
  }
}
